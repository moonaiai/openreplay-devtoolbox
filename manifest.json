{
  "manifest_version": 3,
  "name": "OpenDevToolbox — 开发者工具箱",
  "short_name": "OpenDevToolbox",
  "version": "1.1.0",
  "description": "本地优先的开发者工具箱：原站复刻 105 个 OpenReplay 工具控件（离线可用），并附带轻量会话录制与回放。",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "打开开发者工具箱"
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
